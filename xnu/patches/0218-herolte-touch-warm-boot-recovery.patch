diff --git a/bsd/dev/herolte_touch.c b/bsd/dev/herolte_touch.c
index 390d960..9e41b01 100644
--- a/bsd/dev/herolte_touch.c
+++ b/bsd/dev/herolte_touch.c
@@ -384,6 +384,23 @@ pm_touch_power_on(void)
 
 static vm_offset_t apm_pmu, apm_mbox;
 
+/*
+ * 0218: warm-boot recovery. The first boots after TWRP find the APM held and
+ * the touch LDOs off (the case 0216 was written for). A normal reboot can
+ * find the M3 already released and LDO32/LDO33 already on, with the touch IC
+ * in an unknown state. herotouchfix=0 restores the exact 0216/0217 behaviour.
+ */
+static bool
+ht_fix_enabled(void)
+{
+	static int fix = -1;
+	if (fix < 0) {
+		fix = 1;
+		PE_parse_boot_argn("herotouchfix", &fix, sizeof(fix));
+	}
+	return fix != 0;
+}
+
 static bool
 apm_start(void)
 {
@@ -394,6 +411,14 @@ apm_start(void)
 		return false;
 	}
 	uint32_t opt = ht_rd(apm_pmu, APM_OPTION);
+	if (ht_fix_enabled() && (opt & (1u << 15))) {
+		/* Recreate S-Boot's state (M3 held) so the release below starts clean. */
+		printf("HEROLTE APM: found released (config=%#x status=%#x option=%#x); holding and releasing again\n",
+		    ht_rd(apm_pmu, APM_CONFIG), ht_rd(apm_pmu, APM_STATUS), opt);
+		ht_wr(apm_pmu, APM_OPTION, opt & ~(1u << 15));
+		ht_msleep(20);
+		opt = ht_rd(apm_pmu, APM_OPTION);
+	}
 	if (!(opt & (1u << 15))) {
 		printf("HEROLTE APM: releasing the M3 in 11 s (config=%#x option=%#x)\n",
 		    ht_rd(apm_pmu, APM_CONFIG), opt);
@@ -488,6 +513,18 @@ apm_touch_power_on(void)
 		printf("HEROLTE APM: unexpected LDO32/33 voltage, leaving them off\n");
 		return false;
 	}
+	if (ht_fix_enabled() && ((l32 & S2MPS16_ENABLE) || (l33 & S2MPS16_ENABLE))) {
+		/* Already on from an earlier boot: power-cycle the touch IC (avdd off first). */
+		printf("HEROLTE APM: LDO32/LDO33 already on (%#x %#x); power-cycling the touch IC\n", l32, l33);
+		if (!apm_pmic_write(S2MPS16_L33CTRL, l33 & ~S2MPS16_ENABLE) ||
+		    !apm_pmic_write(S2MPS16_L32CTRL, l32 & ~S2MPS16_ENABLE)) {
+			printf("HEROLTE APM: LDO power-down failed\n");
+			return false;
+		}
+		ht_msleep(200);
+		l32 &= ~S2MPS16_ENABLE;
+		l33 &= ~S2MPS16_ENABLE;
+	}
 	printf("HEROLTE APM: enabling LDO32/LDO33 in 11 s\n");
 	ht_checkpoint();
 	if (!(l32 & S2MPS16_ENABLE) && !apm_pmic_write(S2MPS16_L32CTRL, l32 | S2MPS16_ENABLE)) {
